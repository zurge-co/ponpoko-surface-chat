{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ponpoko.host.ai.v1",
  "contract_version": 1,
  "title": "Ponpoko Host AI API",
  "description": "Provider-neutral inference through registered surface identity. Validation and setup inspection never call a model.",
  "$defs": {
    "ModelIo": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[a-z0-9_-]+$"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[a-z0-9_-]+$"
          }
        }
      },
      "required": [
        "inputs",
        "outputs"
      ],
      "additionalProperties": false
    },
    "InputPart": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z0-9_-]+$"
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "enum": [
            "user",
            "assistant",
            "system",
            null
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "data_base64": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {}
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "data_base64"
          ],
          "properties": {
            "data_base64": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "not": {
                "type": "null"
              }
            }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "InferenceOptions": {
      "type": "object",
      "properties": {
        "temperature": {
          "type": "number"
        },
        "max_tokens": {
          "type": "number"
        },
        "count": {
          "type": "number"
        },
        "dimensions": {
          "type": "number"
        },
        "top_n": {
          "type": "number"
        },
        "seed": {
          "type": "number"
        },
        "speed": {
          "type": "number"
        },
        "duration": {
          "type": "number"
        },
        "voice": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "aspect_ratio": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "InferenceRequest": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxBytes": 128
        },
        "io": {
          "$ref": "#/$defs/ModelIo"
        },
        "input": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/InputPart"
          }
        },
        "options": {
          "$ref": "#/$defs/InferenceOptions"
        },
        "stream": {
          "type": "boolean"
        },
        "budget": {
          "type": "object",
          "properties": {
            "seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            },
            "output_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 33554432
            }
          },
          "required": [
            "seconds",
            "output_bytes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "request_id",
        "io",
        "input",
        "budget"
      ],
      "additionalProperties": false
    },
    "AiEnvelope": {
      "type": "object",
      "properties": {
        "operation": {
          "enum": [
            "contract",
            "validate",
            "invoke",
            "invoke_lookup",
            "invoke_status",
            "invoke_events",
            "invoke_stop",
            "invoke_job_status",
            "invoke_job_cancel",
            "slots",
            "usage"
          ]
        },
        "contract_version": {
          "const": 1
        },
        "input": {
          "$ref": "#/$defs/InferenceRequest"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxBytes": 128
        },
        "after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "check_setup": {
          "type": "boolean"
        }
      },
      "required": [
        "operation",
        "contract_version"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "invoke",
                  "validate"
                ]
              }
            }
          },
          "then": {
            "required": [
              "input"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "invoke_lookup",
                  "invoke_status",
                  "invoke_events",
                  "invoke_stop",
                  "invoke_job_status",
                  "invoke_job_cancel"
                ]
              }
            }
          },
          "then": {
            "required": [
              "request_id"
            ]
          }
        }
      ]
    },
    "OutputPart": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "data_base64": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {},
        "index": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true
    },
    "InferenceResult": {
      "type": "object",
      "properties": {
        "output": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OutputPart"
          }
        },
        "usage": {},
        "job": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "progress": {},
            "error": {}
          },
          "required": [
            "id",
            "status"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "output"
      ],
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/AiEnvelope",
  "examples": [
    {
      "operation": "invoke",
      "contract_version": 1,
      "input": {
        "request_id": "example-lantern",
        "io": {
          "inputs": [
            "text"
          ],
          "outputs": [
            "image"
          ]
        },
        "input": [
          {
            "type": "text",
            "text": "A paper lantern"
          }
        ],
        "budget": {
          "seconds": 120,
          "output_bytes": 1048576
        }
      }
    }
  ]
}
