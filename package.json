{
  "name": "ponpoko-surface-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Chat surface: threads, Markdown and PonpokoUI over the narrow host broker of a Ponpoko surface workspace.",
  "scripts": {
    "dev": "vite",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "build": "bun run typecheck && bunx vite build && bun scripts/bundle.mjs",
    "test": "bun test test",
    "lint": "bunx oxlint --config oxlint.json"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "1.90.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
